# Telegram Bot Token จาก @BotFather (ห้ามใส่ในโค้ด frontend เด็ดขาด)
BOT_TOKEN=

# โหมดรับคำสั่งบอท: ตั้ง BOT_POLLING=true สำหรับรันทั่วไป หรือใช้ Webhook พร้อม WEBHOOK_SECRET
BOT_POLLING=false
WEBHOOK_SECRET=
PUBLIC_APP_URL=

# Secret สำหรับเซ็น token ดูสลิปแบบชั่วคราว (สร้างสุ่มยาวอย่างน้อย 32 ตัวอักษร)
SESSION_SECRET=

# (ตัวเลือก) ล็อกให้เข้าใช้งานได้เฉพาะ Telegram User ID ของเจ้าของคนเดียว
OWNER_TELEGRAM_ID=

# อายุสูงสุดของ Telegram initData (วินาที) ค่าเริ่มต้น 86400 (24 ชั่วโมง)
INIT_DATA_MAX_AGE_SEC=86400

# พอร์ตและโฟลเดอร์เก็บฐานข้อมูล + สลิปแบบ private
PORT=4173
DATA_DIR=./data
NODE_ENV=production

# เปิดเฉพาะตอนทดสอบในเบราว์เซอร์นอก Telegram บนเครื่อง dev เท่านั้น (ห้ามเปิดใน production)
ALLOW_DEV_PREVIEW=false
